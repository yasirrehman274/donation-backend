NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/donation_system
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# true = enforce JWT on every route (after the admin panel gets a login screen)
# false = drop-in compatibility with the current admin panel (recommended until a login exists)
AUTH_ENABLED=false

UPLOAD_LIMIT_MB=5

# Donation screenshot storage. Set all three to store screenshots on Cloudinary
# (secure_url saved in MongoDB, temporary local files deleted). Leave empty to
# keep the local /uploads fallback.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RATE_LIMIT_LIMIT=300
RATE_LIMIT_WINDOW_MS=900000

# Default admin created on first boot / via `npm run seed`
ADMIN_NAME=Syed Zahid Ali
ADMIN_PHONE=03001234567
ADMIN_PASSWORD=admin12345
